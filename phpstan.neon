parameters:
    level: 10

    # Both, and tests is not optional: PHPStan analyses a trait only through a class that
    # uses one, and every line this package ships is in a trait. Analysing src alone
    # reports "trait is used zero times" once per trait and checks nothing at all.
    #
    # tests/ holds three classes that use them, and each is a context worth analysing:
    # ReportCommand (plain Symfony Console, what the package requires), LaravelReportCommand
    # (Illuminate\Console\Command, a dev dependency), and BareRenderer (no console framework
    # at all). The last is the one that would fail if a trait ever reached for something
    # only a framework provides - which is exactly the defect 2.0 removed.
    paths:
        - src
        - tests

    # Analyse against every PHP version the package claims to support, in one run. This
    # covers the PHP axis of the support matrix without running it: PHPStan knows which
    # functions exist in which version and what changed when. Keep in step with the
    # "php" constraint in composer.json.
    phpVersion:
        min: 80300
        max: 80500
