parameters:
    level: 10

    # Both, and tests is not optional: PHPStan analyses a trait only through a class that
    # uses one, and every line this package ships is in a trait. tests/ReportCommand.php
    # is the only class that uses them, so it is what gives them an
    # Illuminate\Console\Command context - and what makes `level: 10` mean anything.
    # Analysing src alone reports "trait is used zero times" four times and checks nothing.
    paths:
        - src
        - tests

    # Analyse against every PHP version the package claims to support, in one run. This
    # covers the PHP axis of the support matrix without running it: PHPStan knows which
    # functions exist in which version and what changed when. Keep in step with the
    # "php" constraint in composer.json.
    phpVersion:
        min: 80300
        max: 80500
